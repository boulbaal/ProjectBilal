# Copy to .env and fill in. Never commit .env.

# --- Meta WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# --- Mailbox ---
MAIL_ADDRESS=
MAIL_PROVIDER=imap
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_PASSWORD=
MAIL_POLL_SECONDS=60

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Server ---
VPS_HOST=
VPS_USER=root
VPS_SSH_KEY=~/.ssh/projectbilal
PUBLIC_DOMAIN=
APPROVAL_SECRET=
PORT=8000
DATA_DIR=./data

# --- People and behaviour ---
APPROVER_EMAILS=
DRY_RUN=true
LOG_LEVEL=INFO
