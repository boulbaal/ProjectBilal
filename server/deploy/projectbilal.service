[Unit]
Description=ProjectBilal customer reply service
After=network-online.target
Wants=network-online.target

[Service]
User=projectbilal
Group=projectbilal
WorkingDirectory=/opt/projectbilal
EnvironmentFile=/opt/projectbilal/.env
Environment=DATA_DIR=/var/lib/projectbilal
ExecStart=/opt/projectbilal/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port __PORT__ --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/projectbilal

[Install]
WantedBy=multi-user.target
